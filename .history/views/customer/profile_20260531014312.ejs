<!-- Khu vực hiển thị thông báo (Toasts/Alerts) -->
<div class="mb-6">
    <% if (req.query.success==='true' || (typeof success !=='undefined' && success)) { %>
        <div
            class="p-4 bg-white border-l-4 border-emerald-500 text-emerald-700 rounded-r-xl shadow-sm flex items-center gap-3 animate-fade-in-up">
            <div class="bg-emerald-100 p-2 rounded-full">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <div>
                <h4 class="font-bold text-sm">Thao tác thành công!</h4>
                <p class="text-xs text-emerald-600 opacity-80">Hồ sơ của bạn đã được cập nhật vào lúc <%= new
                        Date().toLocaleString('vi-VN') %>
                </p>
            </div>
        </div>
        <% } %>

            <% if (typeof errorMsg !=='undefined' && errorMsg) { %>
                <div
                    class="p-4 bg-white border-l-4 border-rose-500 text-rose-700 rounded-r-xl shadow-sm flex items-center gap-3">
                    <div class="bg-rose-100 p-2 rounded-full">
                        <svg class="w-5 h-5 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <div>
                        <h4 class="font-bold text-sm">Đã xảy ra lỗi</h4>
                        <p class="text-xs text-rose-600 opacity-80">
                            <%= errorMsg %>
                        </p>
                    </div>
                </div>
                <% } %>
</div>

<!-- Form Cập nhật Hồ sơ -->
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <form action="/host/profile/<%= (typeof user !== 'undefined' && user) ? user._id : '' %>" method="POST"
        enctype="multipart/form-data" class="block" id="profile-form">

        <!-- Header của form không cần thiết nếu đã có title bên ngoài, nhưng ở đây giữ logic chia section -->

        <!-- Section 1: Thông tin cá nhân & Tài khoản -->
        <div class="p-6 md:p-8 border-b border-slate-100">
            <div class="flex items-center gap-3 mb-6">
                <div class="p-2.5 bg-indigo-50 text-indigo-600 rounded-lg">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                </div>
                <div>
                    <h3 class="font-bold text-lg text-slate-800">Thông tin chủ sở hữu</h3>
                    <p class="text-xs text-slate-500">Quản lý thông tin đăng nhập và bảo mật</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Họ và Tên -->
                <div class="relative">
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Họ và
                        Tên</label>
                    <div class="relative">
                        <span class="absolute left-4 top-3.5 text-slate-400">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                        </span>
                        <input type="text" name="FullName"
                            value="<%= (typeof user !== 'undefined' && user) ? user.FullName : '' %>"
                            class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-700 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all placeholder:text-slate-300"
                            placeholder="VD: Nguyễn Văn A">
                    </div>
                </div>

                <!-- Email -->
                <div class="relative opacity-75 cursor-not-allowed">
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Địa chỉ
                        Email</label>
                    <div class="relative">
                        <span class="absolute left-4 top-3.5 text-slate-400">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                                </path>
                            </svg>
                        </span>
                        <input type="email" Disabled
                            value="<%= (typeof user !== 'undefined' && user) ? user.Email : '' %>"
                            class="w-full pl-11 pr-4 py-3 bg-slate-100 border border-slate-200 rounded-xl text-sm font-medium text-slate-500 cursor-not-allowed"
                            placeholder="email@domain.com">
                    </div>
                    <p class="text-[10px] text-late-400 mt-1 text-right">Liên hệ Admin để thay đổi email</p>
                </div>
            </div>

            <!-- Mật khẩu (Accordion Style) -->
            <div class="mt-6">
                <details class="group p-4 bg-slate-50 rounded-xl border border-slate-200 transition">
                    <summary
                        class="flex justify-between items-center cursor-pointer list-none text-sm font-bold text-slate-700 hover:text-indigo-600">
                        <span class="flex items-center gap-2">
                            <svg class="w-5 h-5 text-slate-400 group-open:text-indigo-500" fill="none"
                                stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z">
                                </path>
                            </svg>
                            👉 Bảo mật & Mật khẩu
                        </span>
                        <span class="transition group-open:rotate-180 text-slate-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </span>
                    </summary>

                    <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4 animate-fade-in">
                        <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Mật khẩu cũ</label>
                            <input type="password" name="OldPassword"
                                class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:border-indigo-500 focus:outline-none"
                                placeholder="••••••">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Mật khẩu
                                mới</label>
                            <input type="password" name="NewPassword" id="new-password"
                                class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:border-indigo-500 focus:outline-none"
                                placeholder="••••••">
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Xác nhận mật
                                khẩu</label>
                            <input
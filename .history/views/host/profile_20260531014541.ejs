
    <!-- Tiêu đề trang -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Cập nhật Hồ sơ</h1>
        <p class="text-slate-500 mt-1">Quản lý thông tin cá nhân và thông tin doanh nghiệp.</p>
    </div>

    <!-- Khu vực Thông báo (Toasts) -->
    <div class="mb-6">
        <% if (req.query.success === 'true' || (typeof success !== 'undefined' && success)) { %>
        <div class="p-4 bg-white border-l-4 border-emerald-500 text-emerald-700 rounded-r-xl shadow-sm flex items-center gap-3 animate-fade-in">
            <div class="bg-emerald-100 p-2 rounded-full">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <div>
                <h4 class="font-bold text-sm">Thao tác thành công!</h4>
                <p class="text-xs text-emerald-600 opacity-80">Hồ sơ đã được cập nhật vào lúc <%= new Date().toLocaleString('vi-VN') %></p>
            </div>
        </div>
        <% } %>

        <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
        <div class="p-4 bg-white border-l-4 border-rose-500 text-rose-700 rounded-r-xl shadow-sm flex items-center gap-3 animate-fade-in">
            <div class="bg-rose-100 p-2 rounded-full">
                <svg class="w-5 h-5 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <div>
                <h4 class="font-bold text-sm">Đã xảy ra lỗi</h4>
                <p class="text-xs text-rose-600 opacity-80"><%= errorMsg %></p>
            </div>
        </div>
        <% } %>
    </div>

    <!-- Form Cập nhật -->
    <form action="/host/profile/<%= (typeof user !== 'undefined' && user) ? user._id : '' %>" method="POST" enctype="multipart/form-data" class="block" id="profile-form">
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- Cột 1: Thông tin Tài khoản -->
            <div class="lg:col-span-1 space-y-6">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-5 border-b border-slate-100 bg-slate-50/50">
                        <h3 class="font-bold text-lg text-slate-800 flex items-center gap-2">
                            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            Tài khoản
                        </h3>
                    </div>
                    <div class="p-6 space-y-5">
                        <!-- Họ Tên -->
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Họ và Tên</label>
                            <div class="relative">
                                <span class="absolute left-3 top-2.5 text-slate-400">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                </span>
                                <input type="text" name="FullName" value="<%= (typeof user !== 'undefined' && user) ? user.FullName : '' %>"
                                    class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-700 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all"
                                    placeholder="Nguyễn Văn A">
                            </div>
                        </div>

                        <!-- Email (Disabled) -->
                        <div class="opacity-75">
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Địa chỉ Email</label>
                            <div class="relative">
                                <span class="absolute left-3 top-2.5 text-slate-400">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                </span>
                                <input type="email" disabled value="<%= (typeof user !== 'undefined' && user) ? user.Email : '' %>"
                                    class="w-full pl-10 pr-4 py-2.5 bg-slate-100 border border-slate-200 rounded-xl text-sm font-medium text-slate-500 cursor-not-allowed">
                            </div>
                            <p class="text-[10px] text-slate-400 mt-1.5 text-right">Liên hệ Admin để đổi email</p>
                        </div>

                        <!-- Accordion Đổi Mật khẩu -->
                        <div class="pt-2">
                            <details class="group p-4 bg-slate-50 rounded-xl border border-slate-200 transition">
                                <summary class="flex justify-between items-center cursor-pointer list-none text-sm font-bold text-slate-700 hover:text-indigo-600 select-none">
                                    <span class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-slate-400 group-open:text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
                                        Bảo mật & Mật khẩu
                                    </span>
                                    <span class="transition group-open:rotate-180 text-slate-400">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                    </span>
                                </summary>
                                <div class="mt-4 grid grid-cols-1 gap-3 animate-fade-in">
                                    <div>
                                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Mật khẩu cũ</label>
                                        <input type="password" name="OldPassword" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:border-indigo-500 focus:outline-none" placeholder="Nhập mật khẩu cũ">
                                    </div>
                                    <div>
                                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Mật khẩu mới</label>
                                        <input type="password" name="NewPassword" id="new-password" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:border-indigo-500 focus:outline-none" placeholder="Nhập mật khẩu mới">
                                    </div>
                                    <div>
                                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Xác nhận mật khẩu</label>
                                        <input type="password" name="ConfirmPassword" id="confirm-password" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:border-indigo-500 focus:outline-none" placeholder="Xác nhận mật khẩu mới" oninput="validatePasswordMatch()">
                                    </div>
                                    <p id="password-error" class="hidden text-xs text-rose-600 font-bold">❌ Mật khẩu không trùng khớp!</p>
                                </div>
                            </details>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột 2 & 3: Thông tin Doanh nghiệp -->
            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                        <h3 class="font-bold text-lg text-slate-800 flex items-center gap-2">
                            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0V11m0 0h4m-4 0H3m12 0h3M12 7h.01M12 11h.01M12 15h.01M17 11h.01M17 15h.01"></path>
                            </svg>
                            Thông tin Doanh nghiệp
                        </h3>
                    </div>
                    
                    <div class="p-6 space-y-6">
                        <!-- Logo & Info Row -->
                        <div class="flex flex-col md:flex-row gap-6 items-start p-4 bg-slate-50 rounded-xl border border-slate-100">
                            <div class="w-24 h-24 bg-white rounded-full border overflow-hidden flex items-center justify-center shadow-sm shrink-0">
                                <img id="logo-preview" src="<%= (typeof profile !== 'undefined' && profile.Logo) ? profile.Logo : 'https://ui-avatars.com/api/?name=Host' %>" class="w-full h-full object-cover" alt="Logo">
                            </div>
                            <div class="flex-1 w-full">
                                <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Logo Thương hiệu</label>
                                <input type="file" name="LogoFile" id="logo-file-input" accept="image/*" onchange="previewImage(event)"
                                    class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer">
                                <p class="text-[10px] text-slate-400 mt-1">Định dạng PNG, JPG. Tối đa 2MB.</p>
                            </div>
                        </div>

                        <!-- Grid Inputs -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div class="md:col-span-2">
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Tên Doanh nghiệp</label>
                                <input type="text" name="CompanyName" value="<%= (typeof profile !== 'undefined' && profile) ? profile.CompanyName : '' %>"
                                    class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
                                    placeholder="Công ty TNHH ABC">
                            </div>
<div class="flex flex-col gap-8">
    <div class="flex justify-between items-center">
        <div>
            <h2 class="text-4xl font-black text-slate-800 uppercase tracking-tighter">Bảng điều hành</h2>
            <p class="text-slate-400 text-sm font-medium">Theo dõi thời gian thực tình hình kinh doanh</p>
        </div>
        <button
            class="bg-teal-600 text-white px-6 py-3 rounded-2xl font-bold shadow-xl hover:bg-teal-700 transition flex items-center gap-3 uppercase text-xs tracking-widest"
            onclick="openModal('modal-qr')">
            <span>📷</span> QUÉT QR CHECK-IN
        </button>
    </div>
    <div class="flex flex-wrap gap-2 bg-white rounded-2xl p-1.5 shadow-sm border border-slate-100 w-fit">
        <button type="button" class="branch-tab active px-5 py-2.5 rounded-xl text-sm font-bold transition" id="tab-all"
            onclick="switchBranch('all')">Tất cả</button>
        <button type="button" class="branch-tab px-5 py-2.5 rounded-xl text-sm font-bold transition" id="tab-q1"
            onclick="switchBranch('q1')">Chi nhánh Q1</button>
        <button type="button" class="branch-tab px-5 py-2.5 rounded-xl text-sm font-bold transition" id="tab-q3"
            onclick="switchBranch('q3')">Chi nhánh Q3</button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <div
            class="relative overflow-hidden bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm group hover:shadow-md transition">
            <span class="absolute -right-1 -top-1 text-7xl opacity-[0.07] pointer-events-none select-none"
                aria-hidden="true">💰</span>
            <p class="text-[10px] text-slate-400 font-black uppercase tracking-wider mb-2 relative z-10">Doanh thu thực
                nhận</p>
            <p class="text-2xl font-black text-slate-800 relative z-10" id="stat-revenue">
                <%= totalRevenue ? totalRevenue.toLocaleString('vi-VN') : '0' %>đ
            </p>
        </div>
        <div
            class="relative overflow-hidden bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm group hover:shadow-md transition">
            <span class="absolute -right-1 -top-1 text-7xl opacity-[0.07] pointer-events-none select-none"
                aria-hidden="true">📅</span>
            <p class="text-[10px] text-slate-400 font-black uppercase tracking-wider mb-2 relative z-10">Tổng Booking
            </p>
            <p class="text-2xl font-black text-slate-800 relative z-10" id="stat-bookings">
                <%= totalBookings %>
            </p>
        </div>
        <div
            class="relative overflow-hidden bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm group hover:shadow-md transition">
            <span class="absolute -right-1 -top-1 text-7xl opacity-[0.07] pointer-events-none select-none"
                aria-hidden="true">👥</span>
            <p class="text-[10px] text-slate-400 font-black uppercase tracking-wider mb-2 relative z-10">Lượt khách</p>
            <p class="text-2xl font-black text-slate-800 relative z-10" id="stat-occupied">128</p>
        </div>
        <div
            class="relative overflow-hidden bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm group hover:shadow-md transition">
            <span class="absolute -right-1 -top-1 text-7xl opacity-[0.07] pointer-events-none select-none"
                aria-hidden="true">🏢</span>
            <p class="text-[10px] text-slate-400 font-black uppercase tracking-wider mb-2 relative z-10">Số chỗ hoạt
                động</p>
            <p class="text-2xl font-black text-slate-800 relative z-10" id="stat-rooms">
                <%= totalSpaces %>
            </p>
        </div>

    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white p-6 md:p-8 rounded-3xl border border-slate-100 shadow-sm">
            <h3 class="font-black text-slate-800 text-sm uppercase tracking-widest mb-6">Xu hướng đặt chỗ</h3>
            <div class="relative h-64 pl-10 pr-2 pb-8">
                <div
                    class="absolute left-0 top-0 bottom-8 w-9 flex flex-col justify-between text-[10px] font-bold text-slate-400 text-right pr-1">
                    <span>40</span>
                    <span>30</span>
                    <span>20</span>
                    <span>10</span>
                    <span>0</span>
                </div>
                <div
                    class="absolute left-10 right-0 top-0 bottom-8 border-l-2 border-b-2 border-slate-200 rounded-bl-sm bg-slate-50/30 overflow-hidden">
                    <div class="absolute inset-0 flex flex-col justify-between pointer-events-none">
                        <div class="border-t border-dashed border-slate-200/80"></div>
                        <div class="border-t border-dashed border-slate-200/80"></div>
                        <div class="border-t border-dashed border-slate-200/80"></div>
                        <div class="border-t border-dashed border-slate-200/80"></div>
                    </div>
                    <div class="absolute inset-y-0 left-1/4 w-px border-l border-dashed border-slate-200/60"></div>
                    <div class="absolute inset-y-0 left-2/4 w-px border-l border-dashed border-slate-200/60"></div>
                    <div class="absolute inset-y-0 left-3/4 w-px border-l border-dashed border-slate-200/60"></div>
                    <svg class="absolute inset-3 w-[calc(100%-1.5rem)] h-[calc(100%-1.5rem)]" viewBox="0 0 280 120"
                        preserveAspectRatio="none" aria-hidden="true">
                        <polyline fill="none" stroke="#0d9488" stroke-width="2.5" stroke-linecap="round"
                            stroke-linejoin="round" points="0,95 40,72 80,58 120,40 160,52 200,28 240,18 280,8" />
                        <linearGradient id="chartAreaFill" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#0d9488" stop-opacity="0.15" />
                            <stop offset="100%" stop-color="#0d9488" stop-opacity="0" />
                        </linearGradient>
                        <polygon fill="url(#chartAreaFill)"
                            points="0,95 40,72 80,58 120,40 160,52 200,28 240,18 280,8 280,120 0,120" />
                    </svg>
                    <p
                        class="absolute inset-0 flex items-center justify-center text-xs font-medium text-slate-300 pointer-events-none select-none">
                        Chart Canvas here</p>
                </div>
                <div
                    class="absolute left-10 right-0 bottom-0 flex justify-between text-[10px] font-bold text-slate-400 px-1">
                    <span>T2</span>
                    <span>T3</span>
                    <span>T4</span>
                    <span>T5</span>
                    <span>T6</span>
                    <span>T7</span>
                    <span>CN</span>
                </div>
            </div>
        </div>

        <div class="lg:col-span-1 bg-white p-6 md:p-8 rounded-3xl border border-slate-100 shadow-sm flex flex-col">
            <h3 class="font-black text-slate-800 text-sm uppercase tracking-widest mb-4">Trạng thái phòng Live</h3>

            <div class="grid grid-cols-4 sm:grid-cols-5 lg:grid-cols-4 gap-2 flex-1 content-start"
                id="host-floor-plan-mini">
                <% if (liveSpaces && liveSpaces.length> 0) { %>
                    <% liveSpaces.forEach(function(space) { let
                        colorClass='bg-emerald-100 border-emerald-200/80 text-emerald-800' ; if (space.status==='in_use'
                        ) { colorClass='bg-red-100 border-red-200/80 text-red-800' ; } else if (space.status==='booked'
                        ) { colorClass='bg-amber-100 border-amber-200/80 text-amber-800' ; } %>
                        <div
                            class="aspect-square min-h-[2.25rem] rounded-lg border flex items-center justify-center text-[10px] font-bold <%= colorClass %>">
                            <%= space.spaceCode %>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <p class="text-xs text-slate-400 col-span-full">Chưa có phòng nào</p>
                                <% } %>
            </div>

            <div
                class="mt-5 pt-4 border-t border-slate-100 flex flex-wrap gap-x-4 gap-y-2 text-[10px] font-bold text-slate-500">
                <span class="flex items-center gap-1.5"><span
                        class="w-3 h-3 rounded-sm bg-emerald-100 border border-emerald-200"></span> Đang trống</span>
                <span class="flex items-center gap-1.5"><span
                        class="w-3 h-3 rounded-sm bg-red-100 border border-red-200"></span> Đang dùng</span>
                <span class="flex items-center gap-1.5"><span
                        class="w-3 h-3 rounded-sm bg-amber-100 border border-amber-200"></span> Đã đặt, sắp tới</span>
            </div>

            <button type="button" onclick="navigateTo('host_spaces')"
                class="w-full mt-4 py-2.5 bg-slate-100 text-slate-600 text-[10px] font-black uppercase rounded-xl hover:bg-slate-200 transition">
                Quản lý phòng
            </button>
        </div>

    </div>

    <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
        <h3 class="font-black text-slate-800 mb-4 uppercase tracking-tight text-sm">📅 Booking gần nhất</h3>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 text-[9px] uppercase text-slate-400 font-black">
                    <tr>
                        <th class="p-3">Khách</th>
                        <th class="p-3">Phòng</th>
                        <th class="p-3">Thời gian</th>
                        <th class="p-3">Trạng thái</th>
                        <th class="p-3">Thanh toán</th>
                    </tr>
                </thead>
                <tbody class="text-[11px]" id="host-recent-table">
                    <% if (recentBookings && recentBookings.length> 0) { %>
                        <% recentBookings.forEach(function(booking) { %>
                            <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition">
                                <td class="p-3">
                                    <%= booking.customerID ? (booking.customerID.name || booking.customerID.fullName
                                        || 'Khách' ) : 'Khách vãng lai' %>
                                </td>
                                <td class="p-3">
                                    <%= booking.spaceID ? booking.spaceID.spaceCode : 'N/A' %>
                                </td>
                                <td class="p-3 font-medium">
                                    <%= new Date(booking.startTime).toLocaleDateString('vi-VN') %>
                                </td>
                                <td class="p-3">
                                    <span class="px-2 py-1 bg-emerald-100 text-emerald-700 rounded-md font-bold">
                                        <%= booking.status %>
                                    </span>
                                </td>
                                <td class="p-3 font-bold text-slate-700">
                                    <%= booking.totalAmount ? booking.totalAmount.toLocaleString('vi-VN') : '0' %>đ
                                </td>
                            </tr>
                            <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="p-4 text-center text-slate-400">Chưa có lượt đặt phòng
                                            nào</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>


    <div class="bg-white p-8 rounded-[2.5rem] border shadow-sm">
        <h3 class="font-black text-xl text-slate-800 uppercase tracking-tighter mb-8">💰 Tài chính chi tiết</h3>
        <div class="grid lg:grid-cols-2 gap-12">
            <div>
                <h4 class="font-bold text-slate-400 text-xs uppercase mb-4 tracking-widest">Phần A: Doanh thu thực</h4>
                <div class="p-6 bg-slate-50 rounded-3xl border border-slate-100">
                    <div class="flex justify-between items-center mb-4">
                        <span class="font-bold text-slate-500">Doanh thu thực:</span>
                        <span class="text-2xl font-black text-slate-800">
                            <%= totalRevenue ? totalRevenue.toLocaleString('vi-VN') : '0' %>đ
                        </span>
                    </div>
                    <div class="space-y-2 text-sm pt-4 border-t border-slate-200">
                        <div class="flex justify-between">
                            <span>🟢 Đã nhận (Cọc/Full):</span>
                            <span class="font-bold text-emerald-600">
                                <%= receivedRevenue ? receivedRevenue.toLocaleString('vi-VN') : '0' %>đ
                            </span>
                        </div>
                        <div class="flex justify-between">
                            <span>⏳ Đang chờ xử lý:</span>
                            <span class="font-bold text-amber-500">
                                <%= pendingRevenue ? pendingRevenue.toLocaleString('vi-VN') : '0' %>đ
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
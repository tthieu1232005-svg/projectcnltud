
<% if (typeof success !=='undefined' || (typeof req !=='undefined' && req.query.success)) { %>
    <div class="mb-4 p-4 bg-green-100 text-green-700 rounded-xl font-bold text-sm">
        🎉 Đã lưu thông tin hồ sơ doanh nghiệp thành công!
    </div>
    <% } %>
    <form action="/host/<%= user._id %>/profile" method="POST" enctype="multipart/form-data">
    <div class="bg-white p-8 rounded-[2.5rem] border shadow-sm mb-6">
        <h3 class="font-black text-lg mb-6 text-slate-800 uppercase">👤 Thông tin chủ sở hữu</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="p-3 bg-slate-50 rounded-xl border">
                <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Họ và Tên</label>
                <input type="text" name="fullName" value="<%= user.fullName || '' %>"
                    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
            </div>
            <div class="p-3 bg-slate-50 rounded-xl border">
                <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Email</label>
                <input type="email" value="<%= user.email || '' %>"
                    class="w-full bg-transparent border-none p-0 text-sm font-semibold outline-none text-slate-500"
                    disabled>
            </div>
            <div class="p-3 bg-slate-50 rounded-xl border">
                <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Mật khẩu mới (Để trống nếu
                    không đổi)</label>
                <input type="password" name="password"
                    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
            </div>
        </div>
    </div>

    <div class="bg-white p-8 rounded-[2.5rem] border shadow-sm">
        <h3 class="font-black text-lg mb-6 text-slate-800 uppercase">🏢 Hồ sơ pháp lý & Vận hành</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2 p-3 bg-slate-50 rounded-xl border">
                <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Tên Doanh nghiệp</label>
                <input type="text" name="companyName" value="<%= profile.companyName || '' %>"
                    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
            </div>
            <div class="p-3 bg-slate-50 rounded-xl border">
                <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Hotline CSKH</label>
                <input type="text" name="hotline" value="<%= profile.hotline || '' %>"
                    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
            </div>
            <div class="p-3 bg-slate-50 rounded-xl border">
                <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Mã số thuế (VAT)</label>
                <input type="text" name="taxCode" value="<%= profile.taxCode || '' %>"
                    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
            </div>
            <div class="p-3 bg-slate-50 rounded-xl border">
                <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Tên ngân hàng</label>
                <input type="text" name="bankName" value="<%= profile.bankName || '' %>"
                    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
            </div>
            <div class="p-3 bg-slate-50 rounded-xl border">
                <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Số tài khoản</label>
                <input type="text" name="bankNumber" value="<%= profile.bankNumber || '' %>"
                    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
            </div>
        </div>

        <div class="mt-8 pt-6 border-t border-slate-100 flex justify-end">
            <button type="submit"
                class="bg-indigo-600 text-white px-8 py-3 rounded-xl font-black text-xs uppercase tracking-widest shadow-lg hover:bg-indigo-700 transition">
                Lưu thay đổi
            </button>
        </div>
    </div>
</form>

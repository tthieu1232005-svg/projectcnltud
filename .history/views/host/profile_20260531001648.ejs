<img id="avatarImage" src="" class="w-full h-full object-cover">
<h3 id="companyNameText" class="text-xl font-bold text-slate-800 mt-2">Đang tải...</h3>

<span id="verifyBadge"
    class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-full text-[10px] font-black uppercase tracking-wider bg-slate-100 text-slate-500">
    Đang kiểm tra...
</span>

<input id="companyNameInput" type="text"
    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
<input id="hotlineInput" type="text"
    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
<input id="taxCodeInput" type="text" placeholder="Chưa cập nhật mã số thuế..."
    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
<input id="bankNameInput" type="text"
    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
<input id="bankNumberInput" type="text"
    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">

<button onclick="saveCompanyProfile()"
    class="bg-teal-600 text-white px-8 py-3 rounded-xl font-black text-xs uppercase tracking-widest shadow-lg hover:bg-teal-700 transition">
    Lưu thay đổi
</button>
<script>
    // 1. Tự động lấy dữ liệu khi mở tran

document.addEventListener("DOMContentLoaded", async () => {

    try {

        const hostId = '6a1904e4578d65ca95a17595';

            const response = await fetch(
            `http://localhost:3000/api/hosts/${hostId}/profile`
            );

            const data = await response.json();

            console.log(data);

            if (data.success) {

            const profile = data.profile;

            document.getElementById('companyNameText').textContent =
            profile.CompanyName;

            document.getElementById('companyNameInput').value =
            profile.CompanyName || '';

            document.getElementById('hotlineInput').value =
            profile.Hotline || '';

            document.getElementById('taxCodeInput').value =
            profile.TaxCode || '';

            document.getElementById('bankNameInput').value =
            profile.BankName || '';

            document.getElementById('bankNumberInput').value =
            profile.BankNumber || '';

            // Avatar
            const avatarUrl = profile.Logo
            ? profile.Logo
            : `https://ui-avatars.com/api/?name=${encodeURIComponent(profile.CompanyName)}&size=200&background=0D8B93&color=fff`;

            document.getElementById('avatarImage').src = avatarUrl;

            // Badge
            const verifyBadge =
            document.getElementById('verifyBadge');

            if (profile.IsVerified) {

                verifyBadge.textContent = 'Đã xác minh';

            verifyBadge.className =
            'inline-flex items-center gap-1.5 py-1.5 px-3 rounded-full text-[10px] font-black uppercase tracking-wider bg-teal-50 text-teal-600 border border-teal-200';

            } else {

                verifyBadge.innerHTML =
                '⚠️ Chưa xác minh';

            verifyBadge.className =
            'inline-flex items-center gap-1.5 py-1.5 px-3 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-50 text-amber-600 border border-amber-200';
            }
        }

    } catch (error) {

                console.error(error);

            alert('Không thể tải dữ liệu!');
    }
});
    </script>
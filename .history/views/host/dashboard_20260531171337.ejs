<div class="flex flex-col gap-8">
    <div class="flex justify-between items-center">
        <div>
            <h2 class="text-4xl font-black text-slate-800 uppercase tracking-tighter">Bảng điều hành</h2>
            <p class="text-slate-400 text-sm font-medium">Theo dõi thời gian thực tình hình kinh doanh</p>
        </div>
        <button
            class="bg-teal-600 text-white px-6 py-3 rounded-2xl font-bold shadow-xl hover:bg-teal-700 transition flex items-center gap-3 uppercase text-xs tracking-widest"
            onclick="alert('Tính năng quét mã QR đang được kết nối!')">
            <span>📷</span> QUÉT QR CHECK-IN
        </button>
    </div>

    <div id="branch-tabs-container"
        class="flex flex-wrap gap-2 bg-white rounded-2xl p-1.5 shadow-sm border border-slate-100 w-fit">
        <button type="button"
            class="branch-tab bg-indigo-600 text-white px-5 py-2.5 rounded-xl text-sm font-bold transition" id="tab-all"
            onclick="switchBranch('all')">Tất cả</button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div
            class="relative overflow-hidden bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm group hover:shadow-md transition">
            <span class="absolute -right-1 -top-1 text-7xl opacity-[0.07] pointer-events-none select-none"
                aria-hidden="true">💰</span>
            <p class="text-[10px] text-slate-400 font-black uppercase tracking-wider mb-2 relative z-10">Doanh thu nhận
                thực tế</p>
            <p class="text-2xl font-black text-slate-800 relative z-10" id="stat-revenue">0đ</p>
        </div>
        <div
            class="relative overflow-hidden bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm group hover:shadow-md transition">
            <span class="absolute -right-1 -top-1 text-7xl opacity-[0.07] pointer-events-none select-none"
                aria-hidden="true">📅</span>
            <p class="text-[10px] text-slate-400 font-black uppercase tracking-wider mb-2 relative z-10">Tổng Đặt Chỗ
            </p>
            <p class="text-2xl font-black text-slate-800 relative z-10" id="stat-bookings">0</p>
        </div>
        <div
            class="relative overflow-hidden bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm group hover:shadow-md transition">
            <span class="absolute -right-1 -top-1 text-7xl opacity-[0.07] pointer-events-none select-none"
                aria-hidden="true">👥</span>
            <p class="text-[10px] text-slate-400 font-black uppercase tracking-wider mb-2 relative z-10">Lượt khách đã
                dùng</p>
            <p class="text-2xl font-black text-slate-800 relative z-10" id="stat-occupied">0</p>
        </div>
        <div
            class="relative overflow-hidden bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm group hover:shadow-md transition">
            <span class="absolute -right-1 -top-1 text-7xl opacity-[0.07] pointer-events-none select-none"
                aria-hidden="true">🏢</span>
            <p class="text-[10px] text-slate-400 font-black uppercase tracking-wider mb-2 relative z-10">Số chỗ đang
                hoạt động</p>
            <p class="text-2xl font-black text-slate-800 relative z-10" id="stat-rooms">0</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white p-6 md:p-8 rounded-3xl border border-slate-100 shadow-sm">
            <h3 class="font-black text-slate-800 text-sm uppercase tracking-widest mb-6">Xu hướng đặt chỗ</h3>
            <div class="relative h-64 pl-10 pr-2 pb-8">
                <div
                    class="absolute left-0 top-0 bottom-8 w-9 flex flex-col justify-between text-[10px] font-bold text-slate-400 text-right pr-1">
                    <span>40</span><span>30</span><span>20</span><span>10</span><span>0</span>
                </div>
                <div
                    class="absolute left-10 right-0 top-0 bottom-8 border-l-2 border-b-2 border-slate-200 rounded-bl-sm bg-slate-50/30 overflow-hidden">
                    <svg class="absolute inset-3 w-[calc(100%-1.5rem)] h-[calc(100%-1.5rem)]" viewBox="0 0 280 120"
                        preserveAspectRatio="none">
                        <polyline fill="none" stroke="#0d9488" stroke-width="2.5"
                            points="0,95 40,72 80,58 120,40 160,52 200,28 240,18 280,8" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="lg:col-span-1 bg-white p-6 md:p-8 rounded-3xl border border-slate-100 shadow-sm flex flex-col">
            <h3 class="font-black text-slate-800 text-sm uppercase tracking-widest mb-4">Trạng thái phòng Live</h3>
            <div class="grid grid-cols-4 sm:grid-cols-5 lg:grid-cols-4 gap-2 flex-1 content-start"
                id="host-floor-plan-mini">
            </div>
            <div
                class="mt-5 pt-4 border-t border-slate-100 flex flex-wrap gap-x-4 gap-y-2 text-[10px] font-bold text-slate-500">
                <span class="flex items-center gap-1.5"><span
                        class="w-3 h-3 rounded-sm bg-emerald-100 border border-emerald-200"></span> Đang trống</span>
                <span class="flex items-center gap-1.5"><span
                        class="w-3 h-3 rounded-sm bg-red-100 border border-red-200"></span> Đang dùng</span>
                <span class="flex items-center gap-1.5"><span
                        class="w-3 h-3 rounded-sm bg-amber-100 border border-amber-200"></span> Sắp có khách</span>
            </div>
        </div>
    </div>

    <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
        <h3 class="font-black text-slate-800 mb-4 uppercase tracking-tight text-sm">📅 Booking gần nhất</h3>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 text-[9px] uppercase text-slate-400 font-black">
                    <tr>
                        <th class="p-3">Khách</th>
                        <th class="p-3">Phòng / Chỗ</th>
                        <th class="p-3">Thời gian đặt</th>
                        <th class="p-3">Trạng thái đơn</th>
                    </tr>
                </thead>
                <tbody class="text-[11px] text-slate-600" id="host-recent-table">
                </tbody>
            </table>
        </div>
    </div>

    <div class="bg-white p-8 rounded-[2.5rem] border shadow-sm">
        <h3 class="font-black text-xl text-slate-800 uppercase tracking-tighter mb-4">💰 Chi tiết dòng tiền</h3>
        <div class="grid lg:grid-cols-1 gap-12">
            <div>
                <div class="p-6 bg-slate-50 rounded-3xl border border-slate-100">
                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between border-b pb-2 mb-2">
                            <span class="font-bold text-slate-700">🟢 Tiền thu thực tế (Thành công):</span>
                            <span class="font-black text-emerald-600 text-lg" id="finance-paid">0đ</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="font-medium text-slate-500">⏳ Số tiền đang treo (Chờ xử lý):</span>
                            <span class="font-bold text-amber-500" id="finance-pending">0đ</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let currentSelectedBranch = 'all';

    document.addEventListener("DOMContentLoaded", function () {
        loadDashboardData('all');
    });

    // Hàm gọi API bốc tách số liệu
    async function loadDashboardData(branchId) {
        const token = localStorage.getItem('token');
        if (!token) {
            alert('Vui lòng đăng nhập để xem dữ liệu!');
            return;
        }

        try {
            const response = await fetch(`/host/api/dashboard-stats?branchId=${branchId}`, {
                method: 'GET',
                headers: { 'Authorization': `Bearer ${token}` }
            });

            const result = await response.json();
            if (!response.ok) {
                console.error(result.error);
                return;
            }

            // 1. Cập nhật các ô số liệu Tổng quan
            document.getElementById('stat-revenue').innerText = result.stats.revenue.toLocaleString('vi-VN') + 'đ';
            document.getElementById('stat-bookings').innerText = result.stats.totalBookings;
            document.getElementById('stat-occupied').innerText = result.stats.totalOccupiedGuests;
            document.getElementById('stat-rooms').innerText = result.stats.activeRoomsCount;

            document.getElementById('finance-paid').innerText = result.stats.paidAmount.toLocaleString('vi-VN') + 'đ';
            document.getElementById('finance-pending').innerText = result.stats.pendingAmount.toLocaleString('vi-VN') + 'đ';

            // 2. Render các thanh chọn Tab Chi nhánh (Chỉ chạy lần đầu tiên)
            if (branchId === 'all' && result.branches) {
                const tabContainer = document.getElementById('branch-tabs-container');
                tabContainer.innerHTML = `<button type="button" class="branch-tab px-5 py-2.5 rounded-xl text-sm font-bold transition ${currentSelectedBranch === 'all' ? 'bg-indigo-600 text-white' : 'text-slate-600'}" onclick="switchBranch('all')">Tất cả</button>`;

                result.branches.forEach(b => {
                    tabContainer.innerHTML += `
                        <button type="button" class="branch-tab px-5 py-2.5 rounded-xl text-sm font-bold transition ${currentSelectedBranch === b._id ? 'bg-indigo-600 text-white' : 'text-slate-600'}" onclick="switchBranch('${b._id}')">
                            ${b.Name}
                        </button>
                    `;
                });
            }

            // 3. Render Sơ đồ Trạng thái phòng Live
            const floorPlanContainer = document.getElementById('host-floor-plan-mini');
            floorPlanContainer.innerHTML = '';
            if (result.liveFloorPlan && result.liveFloorPlan.length > 0) {
                result.liveFloorPlan.forEach(space => {
                    let colorClass = 'bg-emerald-100 border-emerald-200 text-emerald-800'; // Trống
                    if (space.LiveStatus === 'occupied') colorClass = 'bg-rose-100 border-rose-200 text-rose-800'; // Đang dùng
                    if (space.LiveStatus === 'upcoming') colorClass = 'bg-amber-100 border-amber-200 text-amber-800'; // Sắp có khách
                    if (space.LiveStatus === 'maintenance') colorClass = 'bg-slate-200 border-slate-300 text-slate-500'; // Bảo trì

                    floorPlanContainer.innerHTML += `
                        <div class="aspect-square min-h-[2.25rem] rounded-lg flex items-center justify-center text-[10px] font-bold border ${colorClass}">
                            ${space.SpaceCode}
                        </div>
                    `;
                });
            } else {
                floorPlanContainer.innerHTML = '<p class="text-xs text-slate-400 col-span-4">Không có phòng</p>';
            }

            // 4. Render Bảng Booking gần nhất
            const tableBody = document.getElementById('host-recent-table');
            tableBody.innerHTML = '';
            if (result.recentBookings && result.recentBookings.length > 0) {
                result.recentBookings.forEach(b => {
                    const customerName = b.CustomerID ? (b.CustomerID.FullName || b.CustomerID.fullName || 'Khách vãng lai') : 'N/A';
                    const spaceCode = b.SpaceID ? b.SpaceID.SpaceCode : 'N/A';
                    const startTime = new Date(b.StartTime).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });

                    let statusBadge = `<span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-gray-100 text-gray-600">${b.Status}</span>`;
                    if (b.Status === 'confirmed') statusBadge = `<span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-blue-100 text-blue-700">Đã xác nhận</span>`;
                    if (b.Status === 'completed') statusBadge = `<span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-100 text-emerald-700">Hoàn thành</span>`;
                    if (b.Status === 'cancelled') statusBadge = `<span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-red-100 text-red-700">Đã hủy</span>`;

                    tableBody.innerHTML += `
                        <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition">
                            <td class="p-3 font-semibold text-slate-800">${customerName}</td>
                            <td class="p-3 font-bold text-indigo-600">${spaceCode}</td>
                            <td class="p-3 text-slate-500">${startTime}</td>
                            <td class="p-3">${statusBadge}</td>
                        </tr>
                    `;
                });
            } else {
                tableBody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-slate-400">Chưa có lịch đặt chỗ nào gần đây.</td></tr>`;
            }

        } catch (err) {
            console.error("Lỗi khi load dữ liệu Dashboard:", err);
        }
    }

    // Hàm đổi Chi nhánh khi click chọn Tab
   // Hàm đổi Chi nhánh khi click chọn Tab
    function switchBranch(branchId) {
        currentSelectedBranch = branchId;

        // 1. Tìm tất cả các button tab
        const tabs = document.querySelectorAll('.branch-tab');

        tabs.forEach(tab => {
            // Xóa màu tím active và khôi phục màu chữ xám mặc định
            tab.classList.remove('bg-indigo-600', 'text-white');
            tab.classList.add('text-slate-600');

            // 2. Nếu tab này có event chứa branchId được click, thêm lại màu tím
            // Cách này check dựa trên thuộc tính onclick đã gắn ở HTML
            if (tab.getAttribute('onclick').includes(`'${branchId}'`)) {
                tab.classList.remove('text-slate-600');
                tab.classList.add('bg-indigo-600', 'text-white');
            }
        });
        loadDashboardData(branchId);
    }
</script>
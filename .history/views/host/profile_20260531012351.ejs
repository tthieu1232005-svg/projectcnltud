<% if (typeof success !=='undefined' || (typeof req !=='undefined' && req.query.success)) { %>
    <div
        class="mb-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-2xl font-bold text-sm shadow-sm flex items-center gap-2 animate-fade-in">
        <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        🎉 Cập nhật thông tin hồ sơ doanh nghiệp thành công!
    </div>
    <% } %>

        <form action="/host/profile/<%= (typeof user !== 'undefined' && user) ? user._id : '' %>" method="POST"
            class="space-y-6">

            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm transition hover:shadow-md">
                <div class="flex items-center gap-3 mb-6 border-b border-slate-50 pb-4">
                    <div class="p-2 bg-indigo-50 text-indigo-600 rounded-xl">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                    </div>
                    <h3 class="font-black text-base text-slate-800 uppercase tracking-wide">Thông tin chủ sở hữu</h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div
                        class="p-3 bg-slate-50/70 rounded-xl border border-slate-100 focus-within:border-indigo-500 focus-within:bg-white transition">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1 tracking-wider">Họ và
                            Tên</label>
                        <input type="text" name="FullName"
                            value="<%= (typeof user !== 'undefined' && user) ? user.FullName : '' %>"
                            class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800 placeholder-slate-400"
                            placeholder="Nhập họ và tên của bạn">
                    </div>

                    <div class="p-3 bg-slate-100/50 rounded-xl border border-slate-200 opacity-75">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1 tracking-wider">Email
                            (Không thể sửa)</label>
                        <input type="email" value="<%= (typeof user !== 'undefined' && user) ? user.Email : '' %>"
                            class="w-full bg-transparent border-none p-0 text-sm font-semibold outline-none text-slate-500 cursor-not-allowed"
                            disabled>
                    </div>

                    <div
                        class="p-3 bg-slate-50/70 rounded-xl border border-slate-100 focus-within:border-indigo-500 focus-within:bg-white transition md:col-span-2">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1 tracking-wider">Mật
                            khẩu mới (Để trống nếu không đổi)</label>
                        <input type="password" name="Password" placeholder="••••••••"
                            class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
                    </div>
                </div>
            </div>

            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm transition hover:shadow-md">
                <div class="flex items-center gap-3 mb-6 border-b border-slate-50 pb-4">
                    <div class="p-2 bg-blue-50 text-blue-600 rounded-xl">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0V11m0 0h4m-4 0H3m12 0h3M12 7h.01M12 11h.01M12 15h.01M17 11h.01M17 15h.01M7 11h.01M7 15h.01">
                            </path>
                        </svg>
                    </div>
                    <h3 class="font-black text-base text-slate-800 uppercase tracking-wide">Hồ sơ pháp lý & Vận hành
                    </h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div
                        class="md:col-span-2 p-3 bg-slate-50/70 rounded-xl border border-slate-100 focus-within:border-indigo-500 focus-within:bg-white transition">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1 tracking-wider">Tên
                            Doanh nghiệp</label>
                        <input type="text" name="CompanyName"
                            value="<%= (typeof profile !== 'undefined' && profile) ? profile.CompanyName : '' %>"
                            class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800 placeholder-slate-400"
                            placeholder="Nhập tên doanh nghiệp / hộ kinh doanh">
                    </div>

                    <div
                        class="md:col-span-2 p-3 bg-slate-50/70 rounded-xl border border-slate-100 focus-within:border-indigo-500 focus-within:bg-white transition">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1 tracking-wider">Đường
                            dẫn ảnh thương hiệu (Logo URL)</label>
                        <input type="text" name="Logo"
                            value="<%= (typeof profile !== 'undefined' && profile) ? profile.Logo : '' %>"
                            class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800 placeholder-slate-400"
                            placeholder="https://example.com/logo.png">
                    </div>

                    <div
                        class="p-3 bg-slate-50/70 rounded-xl border border-slate-100 focus-within:border-indigo-500 focus-within:bg-white transition">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1 tracking-wider">Hotline
                            CSKH</label>
                        <input type="text" name="Hotline"
                            value="<%= (typeof profile !== 'undefined' && profile) ? profile.Hotline : '' %>"
                            class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800 placeholder-slate-400"
                            placeholder="Số điện thoại hỗ trợ">
                    </div>

                    <div
                        class="p-3 bg-slate-50/70 rounded-xl border border-slate-100 focus-within:border-indigo-500 focus-within:bg-white transition">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1 tracking-wider">Mã số
                            thuế (VAT)</label>
                        <input type="text" name="TaxCode"
                            value="<%= (typeof profile !== 'undefined' && profile) ? profile.TaxCode : '' %>"
                            class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800 placeholder-slate-400"
                            placeholder="Mã số thuế doanh nghiệp">
                    </div>

                    <div
                        class="p-3 bg-slate-50/70 rounded-xl border border-slate-100 focus-within:border-indigo-500 focus-within:bg-white transition">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1 tracking-wider">Tên
                            ngân hàng nhận thanh toán</label>
                        <input type="text" name="BankName"
                            value="<%= (typeof profile !== 'undefined' && profile) ? profile.BankName : '' %>"
                            class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800 placeholder-slate-400"
                            placeholder="Ví dụ: Vietcombank, MB Bank...">
                    </div>

                    <div
                        class="p-3 bg-slate-50/70 rounded-xl border border-slate-100 focus-within:border-indigo-500 focus-within:bg-white transition">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1 tracking-wider">Số tài
                            khoản ngân hàng</label>
                        <input type="text" name="BankNumber"
                            value="<%= (typeof profile !== 'undefined' && profile) ? profile.BankNumber : '' %>"
                            class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800 placeholder-slate-400"
                            placeholder="Nhập số tài khoản nhận tiền">
                    </div>
                </div>

                <div class="mt-8 pt-6 border-t border-slate-100 flex justify-end">
                    <button type="submit"
                        class="bg-indigo-600 hover:bg-indigo-700 text-white px-10 py-3.5 rounded-xl font-bold text-xs uppercase tracking-widest shadow-md hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
                        Lưu thay đổi hồ sơ
                    </button>
                </div>
            </div>
        </form>
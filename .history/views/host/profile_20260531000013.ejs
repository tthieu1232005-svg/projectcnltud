<img id="avatarImage" src="" class="w-full h-full object-cover">
<h3 id="companyNameText" class="text-xl font-bold text-slate-800 mt-2">Đang tải...</h3>

<span id="verifyBadge"
    class="inline-flex items-center gap-1.5 py-1.5 px-3 rounded-full text-[10px] font-black uppercase tracking-wider bg-slate-100 text-slate-500">
    Đang kiểm tra...
</span>

<input id="companyNameInput" type="text"
    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
<input id="hotlineInput" type="text"
    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
<input id="taxCodeInput" type="text" placeholder="Chưa cập nhật mã số thuế..."
    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
<input id="bankNameInput" type="text"
    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">
<input id="bankNumberInput" type="text"
    class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800">

<button onclick="saveCompanyProfile()"
    class="bg-teal-600 text-white px-8 py-3 rounded-xl font-black text-xs uppercase tracking-widest shadow-lg hover:bg-teal-700 transition">
    Lưu thay đổi
</button>
<script>
    // 1. Tự động lấy dữ liệu khi mở trang
    document.addEventListener("DOMContentLoaded", async () => {
        try {
            // Đổi URL này thành API thật của bạn (Ví dụ: /api/company/my-profile)
            const response = await fetch('http://localhost:3000/api/company/my-profile');
            const data = await response.json();

            if (data) {
                // Đổ dữ liệu vào giao diện
                document.getElementById('companyNameText').textContent = data.CompanyName;
                document.getElementById('companyNameInput').value = data.CompanyName;
                document.getElementById('hotlineInput').value = data.Hotline;
                document.getElementById('taxCodeInput').value = data.TaxCode || '';
                document.getElementById('bankNameInput').value = data.BankName || '';
                document.getElementById('bankNumberInput').value = data.BankNumber || '';

                // Xử lý Avatar (Nếu rỗng thì tạo avatar tự động bằng tên)
                const avatarUrl = data.Logo ? data.Logo : `https://ui-avatars.com/api/?name=${encodeURIComponent(data.CompanyName)}&size=200&background=0D8B93&color=fff`;
                document.getElementById('avatarImage').src = avatarUrl;

                // Xử lý Badge Xác minh (IsVerified)
                const verifyBadge = document.getElementById('verifyBadge');
                if (data.IsVerified) {
                    verifyBadge.textContent = "Đã xác minh";
                    verifyBadge.className = "inline-flex items-center gap-1.5 py-1.5 px-3 rounded-full text-[10px] font-black uppercase tracking-wider bg-teal-50 text-teal-600 border border-teal-200";
                } else {
                    verifyBadge.innerHTML = `<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg> Chưa xác minh`;
                    verifyBadge.className = "inline-flex items-center gap-1.5 py-1.5 px-3 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-50 text-amber-600 border border-amber-200";
                }
            }
        } catch (error) {
            console.error("Lỗi tải dữ liệu:", error);
            alert("Không thể tải thông tin doanh nghiệp!");
        }
    });

    // 2. Hàm Lưu thay đổi gửi ngược về MongoDB
    async function saveCompanyProfile() {
        const updateData = {
            CompanyName: document.getElementById('companyNameInput').value,
            Hotline: document.getElementById('hotlineInput').value,
            TaxCode: document.getElementById('taxCodeInput').value,
            BankName: document.getElementById('bankNameInput').value,
            BankNumber: document.getElementById('bankNumberInput').value
        };

        try {
            const response = await fetch('http://localhost:3000/api/company/update', {
                method: 'PUT', // Hoặc POST tùy backend của bạn
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(updateData)
            });

            if (response.ok) {
                alert("Đã lưu thông tin doanh nghiệp thành công!");
                // Cập nhật lại tên ở giao diện ngoài
                document.getElementById('companyNameText').textContent = updateData.CompanyName;
            } else {
                alert("Lưu thất bại, vui lòng thử lại.");
            }
        } catch (error) {
            console.error("Lỗi lưu dữ liệu:", error);
        }
    }
</script>
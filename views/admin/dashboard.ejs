    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <div class="p-5 bg-teal-50 rounded-xl border border-teal-100 flex items-center justify-between">
            <div>
                <p class="text-xs font-bold text-teal-600 uppercase tracking-wider mb-1">Người dùng</p>
                <h2 class="text-3xl font-black text-teal-800" id="stat-users">0</h2>
            </div>
            <div class="text-teal-200 text-4xl">👥</div>
        </div>

        <div class="p-5 bg-indigo-50 rounded-xl border border-indigo-100 flex items-center justify-between">

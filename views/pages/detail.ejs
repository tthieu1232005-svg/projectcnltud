<!-- Chi tiết không gian & Chọn chỗ -->
<div class="flex flex-col lg:flex-row gap-8">
    <div class="flex-1">
        <div class="bg-white rounded-3xl p-2 shadow-sm border border-slate-200 mb-6 overflow-hidden">
            <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&q=80&w=1000" class="w-full h-72 object-cover rounded-2xl" alt="Space Detail">
        </div>
        <h2 class="text-2xl font-black text-slate-800 mb-2">Phòng họp Modern - District 1</h2>
        <p class="text-slate-500 text-sm leading-relaxed mb-8">Không gian chuyên nghiệp với đầy đủ tiện nghi.</p>
        <div id="reviews-section" class="mt-8 bg-white p-8 rounded-3xl shadow-sm border border-slate-200">
            <h3 class="font-bold text-xl mb-4 text-slate-800 uppercase tracking-tight">Đánh giá khách hàng</h3>
            <div class="space-y-4" id="review-items-list">
                <div class="border-b border-slate-100 pb-4">
                    <div class="flex justify-between font-bold text-xs text-slate-400"><span>Nguyễn Văn An</span><span>20/03/2026</span></div>
                    <div class="flex text-amber-500 text-xs my-1">★★★★☆</div>
                    <p class="text-sm text-slate-600 italic">"Yên tĩnh, wifi nhanh."</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="w-full lg:w-80">
        <div class="bg-white p-6 rounded-3xl shadow-lg border border-slate-100 sticky top-24">
            <h3 class="font-black text-xl mb-4 border-b pb-2 text-teal-800 uppercase tracking-tighter">Đặt chỗ</h3>
            <div class="space-y-4 mb-4">
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Ngày thuê</label>
                    <input type="date" value="2026-03-26" class="w-full p-2 bg-slate-50 border-none rounded-lg text-sm font-bold">
                </div>
                <div class="flex gap-2">
                    <div class="flex-1">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Từ giờ</label>
                        <input type="time" id="booking-start-time" value="08:00" class="w-full p-2 bg-slate-50 border-none rounded-lg text-sm font-bold">
                    </div>
                    <div class="flex-1">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Đến giờ</label>
                        <input type="time" id="booking-end-time" value="10:00" class="w-full p-2 bg-slate-50 border-none rounded-lg text-sm font-bold">
                    </div>
                </div>
                <button onclick="checkAvailableSlots()" class="w-full py-2.5 bg-teal-100 text-teal-700 font-black text-[11px] uppercase tracking-widest rounded-xl hover:bg-teal-200 transition">Xem tình trạng trống</button>
            </div>
            
            <div id="available-slots-container" class="hidden mt-6 space-y-3 animate-fadeIn">
                <p class="text-[10px] font-black text-slate-400 uppercase border-t pt-4 mb-2">Vị trí còn trống:</p>
                <div class="grid grid-cols-2 gap-2" id="available-slots-list"></div>
            </div>
            
            <div id="booking-summary" class="hidden mt-6 pt-6 border-t border-dashed border-slate-100">
                <div id="val-deposit" class="text-teal-700 font-black text-center mb-4 text-xl">Cọc: 150.000đ</div>
                <button onclick="checkAuthAndGoToPayment()" class="w-full bg-orange-500 text-white py-4 rounded-2xl font-bold hover:bg-orange-600 transition shadow-lg uppercase text-xs tracking-widest">Xác nhận & Thanh toán</button>
            </div>
        </div>
    </div>
</div>
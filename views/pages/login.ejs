<!-- Đăng nhập --><div class="max-w-md mx-auto py-10 px-8 border bg-white rounded-[2rem] shadow-2xl transition-all duration-500">
    
    <div id="role-selection-area">
        <h2 class="text-2xl font-black mb-2 text-slate-800 uppercase tracking-tight text-center">Đăng nhập WorkHub</h2>
        <p class="text-slate-400 mb-10 text-sm font-medium italic text-center">Chọn vai trò của bạn để tiếp tục</p>
        
        <div class="space-y-4">
            <button onclick="prepareLogin('customer')" class="w-full bg-teal-600 text-white py-4 rounded-xl font-bold hover:bg-teal-700 transition uppercase text-xs tracking-widest shadow-lg shadow-teal-100 flex items-center justify-center gap-3">
                <span>🧑‍💻</span> Khách hàng đăng nhập
            </button>
            <button onclick="prepareLogin('host')" class="w-full bg-indigo-600 text-white py-4 rounded-xl font-bold hover:bg-indigo-700 transition uppercase text-xs tracking-widest shadow-lg shadow-indigo-100 flex items-center justify-center gap-3">
                <span>🏢</span> Chủ cơ sở đăng nhập
            </button>
        </div>

        <div class="mt-8 pt-6 border-t border-slate-100 text-center">
            <p class="text-slate-500 text-sm mb-3 font-medium">Bạn chưa có tài khoản?</p>
            <a href="/register" class="text-teal-600 font-bold text-sm hover:underline">Đăng ký tài khoản mới</a>
        </div>
    </div>

    <div id="login-form-area" class="hidden animate-fadeIn">
        <button onclick="backToRoleSelect()" class="text-slate-400 hover:text-teal-600 mb-6 flex items-center gap-2 font-bold text-xs uppercase tracking-widest">
            ← Quay lại
        </button>
        
        <h2 class="text-2xl font-black mb-2 text-slate-800 uppercase tracking-tight" id="login-title">Đăng nhập</h2>
        <p class="text-slate-400 mb-8 text-sm font-medium italic" id="login-subtitle">Nhập thông tin tài khoản của bạn</p>

        <div class="space-y-4">
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Email</label>
                <input type="email" id="login-email" placeholder="name@email.com" class="w-full bg-transparent border-none p-0 text-sm font-bold focus:ring-0 outline-none text-slate-800">
            </div>
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Mật khẩu</label>
                <input type="password" id="login-password" placeholder="••••••••" class="w-full bg-transparent border-none p-0 text-sm font-bold focus:ring-0 outline-none text-slate-800">
            </div>
            
            <button onclick="handleLoginSubmit()" class="w-full bg-slate-800 text-white py-4 rounded-xl font-bold hover:bg-slate-900 transition uppercase text-xs tracking-widest shadow-lg mt-4">
                Đăng nhập ngay
            </button>
        </div>
    </div>
</div>
<h2 class="text-2xl font-black text-slate-800 mb-8 tracking-tighter uppercase">Cài đặt Doanh nghiệp</h2>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-6xl">
    <div class="lg:col-span-1">
        <div class="bg-white p-8 rounded-[2rem] border text-center shadow-sm">
            <div class="relative w-32 h-32 mx-auto mb-4">
                <div class="w-full h-full rounded-full border-4 border-indigo-50 bg-indigo-100 flex items-center justify-center overflow-hidden shadow-inner"><img id="profile-avatar-preview" src="https://ui-avatars.com/api/?name=Work+Hub&size=200&background=4f46e5&color=fff" class="w-full h-full object-cover"></div>
            </div>
            <h3 class="text-xl font-bold text-slate-800 mt-2">WorkHub Official</h3>
            <p class="text-xs text-indigo-500 font-bold uppercase tracking-widest mt-1">Tài khoản Quản lý</p>
        </div>
    </div>
    <div class="lg:col-span-2">
        <div class="bg-white p-8 rounded-[2.5rem] border shadow-sm">
            <h3 class="font-black text-lg mb-6 text-slate-800 flex items-center gap-2 uppercase tracking-tighter"><span>🏢</span> Hồ sơ pháp lý & Vận hành</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="md:col-span-2 p-3 bg-slate-50 rounded-xl border border-slate-100"><label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Tên Doanh nghiệp / Chủ cơ sở</label><input type="text" value="Công ty TNHH WorkHub" class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800"></div>
                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100"><label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Email Quản trị</label><input type="email" value="admin@workhub.com" class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-500" disabled></div>
                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100"><label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Hotline CSKH</label><input type="text" placeholder="VD: 1900 xxxx" class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800"></div>
                <div class="md:col-span-2 p-3 bg-slate-50 rounded-xl border border-slate-100"><label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Mã số thuế (VAT)</label><input type="text" placeholder="Nhập mã số thuế doanh nghiệp..." class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800"></div>
            </div>
            <div class="mt-8 pt-6 border-t border-slate-100 flex justify-end"><button onclick="showToast('Đã lưu thông tin doanh nghiệp!')" class="bg-indigo-600 text-white px-8 py-3 rounded-xl font-black text-xs uppercase tracking-widest shadow-lg hover:bg-indigo-700 transition">Lưu thay đổi</button></div>
        </div>
    </div>
</div>
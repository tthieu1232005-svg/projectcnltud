<!-- Wizard thêm cơ sở (2 giai đoạn) -->
<div id="space-mgr-layer-add" class="hidden">
    <button type="button" onclick="cancelAddFacility()" class="text-slate-400 hover:text-teal-600 mb-6 flex items-center gap-2 font-bold text-sm">← Quay lại danh sách cơ sở</button>

    <div class="bg-white p-6 md:p-8 rounded-[2.5rem] border border-slate-100 shadow-sm max-w-4xl mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 border-b border-slate-100 pb-6">
            <div>
                <h2 class="text-2xl font-black text-slate-800 uppercase tracking-tighter">Thêm cơ sở mới</h2>
                <p class="text-slate-400 text-sm font-medium mt-1" id="add-facility-step-label">Giai đoạn 1: Nhập thông tin cơ sở</p>
            </div>
            <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-widest">
                <span id="add-fac-step-1-badge" class="px-4 py-2 rounded-xl bg-teal-600 text-white">1. Cơ sở</span>
                <span class="text-slate-300">→</span>
                <span id="add-fac-step-2-badge" class="px-4 py-2 rounded-xl bg-slate-100 text-slate-400">2. Không gian</span>
            </div>
        </div>

        <!-- Giai đoạn 1 -->
        <div id="add-facility-step-1" class="space-y-5">
            <div>
                <p class="text-[10px] font-black text-slate-400 uppercase mb-2 pl-1">Hình ảnh minh họa</p>
                <div class="flex flex-wrap items-start gap-4">
                    <div id="add-fac-image-preview" class="h-28 w-40 bg-slate-100 rounded-2xl overflow-hidden border border-slate-200 shadow-inner flex items-center justify-center">
                        <span class="text-[10px] font-bold text-slate-400 uppercase">Chưa có ảnh</span>
                    </div>
                    <label class="h-28 w-40 border-2 border-dashed border-slate-200 rounded-2xl flex flex-col items-center justify-center text-slate-400 font-bold text-[10px] uppercase cursor-pointer hover:border-teal-500 hover:text-teal-600 transition">
                        <span class="text-2xl mb-1">+</span>
                        <span>Chọn ảnh</span>
                        <input type="file" id="add-fac-image" accept="image/*" class="hidden" onchange="previewFacilityImage(this)">
                    </label>
                </div>
            </div>
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                <label for="add-fac-name" class="block text-[10px] font-black text-slate-400 uppercase mb-1">Tên cơ sở <span class="text-red-500">*</span></label>
                <input type="text" id="add-fac-name" placeholder="VD: WorkHub Skyview Q7" class="w-full bg-transparent border-none p-0 text-sm font-bold focus:ring-0 outline-none text-slate-800">
            </div>
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                <label for="add-fac-address" class="block text-[10px] font-black text-slate-400 uppercase mb-1">Địa chỉ <span class="text-red-500">*</span></label>
                <input type="text" id="add-fac-address" placeholder="Số nhà, đường, quận, thành phố" class="w-full bg-transparent border-none p-0 text-sm font-bold focus:ring-0 outline-none text-slate-800">
            </div>
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                <label for="add-fac-note" class="block text-[10px] font-black text-slate-400 uppercase mb-1">Ghi chú mô tả</label>
                <textarea id="add-fac-note" rows="3" placeholder="Mô tả ngắn về cơ sở, tiện ích, giờ mở cửa..." class="w-full bg-transparent border-none p-0 text-sm font-medium focus:ring-0 outline-none text-slate-700 resize-none"></textarea>
            </div>
            <button type="button" onclick="addFacilityGoStep2()" class="w-full bg-teal-600 text-white py-4 rounded-2xl font-black text-xs uppercase shadow-lg shadow-teal-100 hover:bg-teal-700 transition">
                Tiếp tục — Thêm không gian →
            </button>
        </div>

        <!-- Giai đoạn 2 -->
        <div id="add-facility-step-2" class="hidden space-y-5">
            <div class="p-4 bg-teal-50/50 rounded-2xl border border-teal-100 text-sm">
                <p class="text-[10px] font-black text-teal-600 uppercase mb-1">Cơ sở đang tạo</p>
                <p class="font-black text-slate-800" id="add-fac-summary-name">—</p>
                <p class="text-slate-500 text-xs mt-0.5" id="add-fac-summary-address">—</p>
            </div>
            <div id="add-facility-spaces-list" class="space-y-4"></div>
            <button type="button" onclick="addFacilitySpaceRow()" class="w-full py-3 border-2 border-dashed border-slate-200 rounded-2xl text-slate-500 font-black text-[10px] uppercase hover:border-teal-500 hover:text-teal-600 transition">
                + Thêm không gian khác
            </button>
            <div class="flex flex-col sm:flex-row gap-3 pt-2">
                <button type="button" onclick="addFacilityBackToStep1()" class="flex-1 py-4 rounded-2xl font-black text-xs uppercase bg-slate-100 text-slate-600 hover:bg-slate-200 transition">
                    ← Quay lại thông tin cơ sở
                </button>
                <button type="button" onclick="saveNewFacility()" class="flex-1 py-4 rounded-2xl font-black text-xs uppercase bg-teal-600 text-white shadow-lg hover:bg-teal-700 transition">
                    Hoàn tất & Lưu cơ sở
                </button>
            </div>
        </div>
    </div>
</div>

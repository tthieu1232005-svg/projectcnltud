<div class="flex flex-col gap-6">
    <div class="flex justify-between items-center">
        <div>
            <h2 class="text-3xl font-black text-slate-800 uppercase tracking-tighter">Quản lý đơn đặt chỗ</h2>
            <p class="text-slate-500 text-sm font-medium">Theo dõi và vận hành đơn hàng thực tế.</p>
        </div>
        <button class="bg-teal-600 text-white px-6 py-3 rounded-2xl font-bold shadow-xl hover:bg-teal-700 transition flex items-center gap-3 text-xs tracking-widest uppercase" onclick="openModal('modal-qr')">
            <span>📷</span> Quét mã QR
        </button>
    </div>
    <div class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm">
        <div class="flex flex-col md:flex-row gap-4 justify-between items-center">
            <div class="flex gap-2 bg-slate-50 p-1 rounded-[2rem] border border-slate-100 overflow-x-auto max-w-full">
                <div class="booking-filter-tab active cursor-pointer px-4 py-2 rounded-xl text-sm font-bold transition-all" onclick="filterHostBookings('all', this)">Tất cả</div>
                <div class="booking-filter-tab cursor-pointer px-4 py-2 rounded-xl text-sm font-bold text-slate-500 hover:bg-white transition-all" onclick="filterHostBookings('pending', this)">Chờ duyệt (3)</div>
                <div class="booking-filter-tab cursor-pointer px-4 py-2 rounded-xl text-sm font-bold text-slate-500 hover:bg-white transition-all" onclick="filterHostBookings('confirmed', this)">Đã xác nhận</div>
                <div class="booking-filter-tab cursor-pointer px-4 py-2 rounded-xl text-sm font-bold text-slate-500 hover:bg-white transition-all" onclick="filterHostBookings('in-use', this)">Đang dùng</div>
                <div class="booking-filter-tab cursor-pointer px-4 py-2 rounded-xl text-sm font-bold text-slate-500 hover:bg-white transition-all" onclick="filterHostBookings('completed', this)">Lịch sử</div>
            </div>
            <div class="relative w-full md:w-80 flex items-center bg-slate-50 border border-slate-200 rounded-2xl p-1 focus-within:border-teal-500 transition-all">
    <input type="text" 
           id="booking-search-input" 
           placeholder="Tìm email khách, mã đơn..." 
           class="w-full pl-3 pr-12 py-2 bg-transparent border-none outline-none text-sm font-medium text-slate-700">
    
    <button type="button" 
            onclick="handleBookingSearch()" 
            class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 flex items-center justify-center bg-teal-600 text-white rounded-xl hover:bg-teal-700 transition shadow-md active:scale-95">
        🔍
    </button>
</div>
        </div>
    </div>
    <div class="bg-white rounded-[2rem] border border-slate-100 shadow-sm overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-slate-50 border-b text-[10px] uppercase text-slate-400 font-black tracking-widest">
                <tr><th class="p-5">Mã đơn / Khách</th><th class="p-5">Không gian</th><th class="p-5">Thời gian</th><th class="p-5">Thanh toán</th><th class="p-5">Trạng thái</th><th class="p-5 text-right">Hành động</th></tr>
            </thead>
            <tbody class="text-xs" id="host-booking-table-body"></tbody>
        </table>
        <div class="p-10 text-center" id="booking-empty-state" style="display: none;">
            <div class="text-4xl mb-4 opacity-20">📂</div>
            <p class="text-slate-400 font-bold uppercase text-[10px]">Trống</p>
        </div>
    </div>
</div>

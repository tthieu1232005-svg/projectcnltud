<h2 class="text-2xl font-black text-slate-800 mb-8 tracking-tighter uppercase">Hồ sơ Khách hàng</h2>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-6xl">
    <div class="lg:col-span-1">
        <div class="bg-white p-8 rounded-[2rem] border text-center shadow-sm">
            <div class="relative w-32 h-32 mx-auto mb-4">
                <div class="w-full h-full rounded-full border-4 border-teal-50 bg-teal-100 flex items-center justify-center overflow-hidden shadow-inner">
                    <img id="profile-avatar-preview" src="https://ui-avatars.com/api/?name=User&size=200" class="w-full h-full object-cover" alt="Avatar" />
                </div>

                <label class="absolute bottom-0 right-0 bg-teal-600 text-white p-2 rounded-full cursor-pointer shadow-lg hover:bg-teal-700 transition scale-90">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
                        <path d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <input type="file" class="hidden" accept="image/*" onchange="previewProfileImage(this)" />
                </label>
            </div>

            <h3 class="text-xl font-bold text-slate-800 mt-2" id="profile-fullname">Người dùng</h3>
            <p class="text-xs text-slate-500 font-bold uppercase tracking-widest mt-1">Khách hàng</p>
        </div>
    </div>

    <div class="lg:col-span-2">
        <div class="bg-white p-8 rounded-[2.5rem] border shadow-sm">
            <h3 class="font-black text-lg mb-6 text-slate-800 flex items-center gap-2 uppercase tracking-tighter">
                <span>📝</span> Thông tin chi tiết
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Họ và tên</label>
                    <input id="profile-job-fullname" type="text" placeholder="Nhập họ và tên" class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800" />
                </div>

                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Email đăng nhập</label>
                    <input id="profile-email" type="email" placeholder="Email" class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-500" disabled />
                </div>

                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Số điện thoại liên hệ</label>
                    <input id="profile-phone" type="text" placeholder="Nhập số điện thoại..." class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800" />
                </div>

                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Nghề nghiệp</label>
                    <input id="profile-jobtitle" type="text" placeholder="VD: Sinh viên, Lập trình viên..." class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800" />
                </div>

                <div class="md:col-span-2 p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Trường học / Công ty</label>
                    <input id="profile-company" type="text" placeholder="Tên công ty hoặc trường học của bạn..." class="w-full bg-transparent border-none p-0 text-sm font-semibold focus:ring-0 outline-none text-slate-800" />
                </div>
            </div>

            <details class="group p-4 bg-slate-50 rounded-xl border border-slate-200 transition mb-6">
                <summary class="flex justify-between items-center cursor-pointer list-none text-sm font-bold text-slate-700 hover:text-teal-600 outline-none">
                    <span class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-slate-400 group-open:text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
                        👉 Bảo mật & Đổi mật khẩu
                    </span>
                    <span class="transition group-open:rotate-180 text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </span>
                </summary>
                
                <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4 animate-fade-in items-end">
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Mật khẩu cũ</label>
                        <input type="password" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:border-teal-500 focus:outline-none" placeholder="••••••">
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Mật khẩu mới</label>
                        <input type="password" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:border-teal-500 focus:outline-none" placeholder="••••••">
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Xác nhận mật khẩu</label>
                        <input type="password" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:border-teal-500 focus:outline-none" placeholder="••••••">
                    </div>
                    <div class="md:col-span-3 flex justify-end mt-2">
                        <button type="button" class="bg-slate-800 text-white px-6 py-2 rounded-xl font-bold text-xs uppercase tracking-widest hover:bg-slate-900 transition shadow-md">
                            THAY ĐỔI MẬT KHẨU
                        </button>
                    </div>
                </div>
            </details>

            <div class="pt-6 border-t border-slate-100 flex justify-end gap-3">
                <button type="button" onclick="saveProfile()" class="bg-teal-600 text-white px-8 py-3 rounded-xl font-black text-xs uppercase tracking-widest shadow-lg hover:bg-teal-700 transition">
                    Lưu thay đổi
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function previewProfileImage(input) {
        const file = input.files && input.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = () => {
            const img = document.getElementById('profile-avatar-preview');
            if (img) img.src = reader.result;
        };
        reader.readAsDataURL(file);
    }

    async function loadProfile() {
        const userId = localStorage.getItem('userId');
        const token = localStorage.getItem('token');

        if (!userId || !token) return;

        try {
            const res = await fetch(`/api/customers/${userId}/profile`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            });

            const data = await res.json();
            if (!res.ok) throw new Error(data?.error || 'Không tải được hồ sơ');

            const user = data.user || {};
            const profile = data.profile || {};

            document.getElementById('profile-fullname').textContent = user.FullName || user.fullName || 'Người dùng';
            document.getElementById('profile-job-fullname').value = user.FullName || user.fullName || '';
            document.getElementById('profile-email').value = user.Email || user.email || '';
            document.getElementById('profile-phone').value = profile.Phone || profile.phone || '';
            document.getElementById('profile-jobtitle').value = profile.JobTitle || profile.jobTitle || '';
            document.getElementById('profile-company').value = profile.Company || profile.company || '';

            const avatar = profile.Avatar || profile.avatar || '';
            if (avatar) document.getElementById('profile-avatar-preview').src = avatar;
        } catch (e) {
            console.error(e);
        }
    }

    async function saveProfile() {
        const userId = localStorage.getItem('userId');
        const token = localStorage.getItem('token');

        if (!userId || !token) {
            if(typeof showToast === 'function') showToast('Bạn chưa đăng nhập!');
            return;
        }

        const payload = {
            Phone: document.getElementById('profile-phone').value || '',
            JobTitle: document.getElementById('profile-jobtitle').value || '',
            Company: document.getElementById('profile-company').value || ''
        };

        try {
            const res = await fetch(`/api/customers/${userId}/profile`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            if (!res.ok) throw new Error(data?.error || 'Lưu thất bại');

            if(typeof showToast === 'function') showToast('Đã lưu thông tin khách hàng!');
            else alert('Đã lưu thông tin khách hàng!');
            
            await loadProfile();
        } catch (e) {
            console.error(e);
            if(typeof showToast === 'function') showToast(e.message || 'Lỗi lưu hồ sơ');
            else alert(e.message || 'Lỗi lưu hồ sơ');
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        loadProfile();
    });
</script>
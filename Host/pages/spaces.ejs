<div id="space-mgr-layer-1">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4 mb-8">
        <div>
            <h2 class="text-3xl font-black text-slate-800 mb-2 uppercase tracking-tighter">Quản lý không gian</h2>
            <p class="text-slate-500">Chọn một cơ sở để bắt đầu quản lý hoặc thêm cơ sở mới</p>
        </div>
        <button type="button" onclick="startAddFacility()" class="px-6 py-3 bg-teal-600 text-white rounded-2xl font-black text-xs uppercase shadow-lg shadow-teal-100 hover:bg-teal-700 transition flex items-center gap-2 shrink-0">
            <span class="text-lg leading-none">+</span> Thêm cơ sở
        </button>
    </div>
    <div id="facility-list-grid" class="grid md:grid-cols-2 gap-6">
        <div onclick="openFacilityMgmt('central')" class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm hover:shadow-xl hover:border-teal-500 transition cursor-pointer group">
            <div class="relative h-40 mb-6 rounded-2xl overflow-hidden shadow-inner">
                <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=800" class="w-full h-full object-cover group-hover:scale-110 transition duration-500" alt="">
                <div class="absolute top-3 right-3 bg-white/90 px-3 py-1 rounded-full text-[10px] font-black text-teal-600 uppercase">4 Vị trí</div>
            </div>
            <h3 class="text-xl font-black text-slate-800 tracking-tight">WorkHub Central Q1</h3>
            <p class="text-sm text-slate-400">123 Lê Lợi, Phường Bến Thành, Quận 1</p>
        </div>
    </div>
</div>

<%- include('../partials/add_facility_wizard') %>

<div id="space-mgr-layer-2" class="hidden">
    <button type="button" onclick="backToLayer1()" class="text-slate-400 hover:text-teal-600 mb-6 flex items-center gap-2 font-bold text-sm">← Quay lại danh sách cơ sở</button>
    <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-1 space-y-6">
            <div class="bg-white p-8 rounded-[2.5rem] border shadow-sm">
                <h3 class="font-black text-xl mb-6 text-slate-800 border-b pb-2">Thông tin cơ sở</h3>
                <div class="space-y-4">
                    <div class="grid grid-cols-2 gap-2">
                        <div class="h-20 bg-slate-100 rounded-xl relative overflow-hidden">
                            <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=300" class="w-full h-full object-cover" alt="">
                        </div>
                        <div class="h-20 border-2 border-dashed border-slate-200 rounded-xl flex items-center justify-center text-slate-400 font-bold text-[10px] uppercase">+ ẢNH</div>
                    </div>
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Tên cơ sở</label>
                        <input type="text" data-fac-field="name" value="WorkHub Central Q1" class="w-full bg-transparent border-none p-0 text-sm font-bold focus:ring-0 outline-none">
                    </div>
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Địa chỉ</label>
                        <input type="text" data-fac-field="address" value="123 Lê Lợi, Quận 1" class="w-full bg-transparent border-none p-0 text-sm font-bold focus:ring-0 outline-none">
                    </div>
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Ghi chú mô tả</label>
                        <textarea data-fac-field="note" class="w-full bg-transparent border-none p-0 text-sm font-medium focus:ring-0 outline-none h-20 resize-none">Chi nhánh trung tâm nhất của hệ thống...</textarea>
                    </div>
                    <button type="button" class="w-full bg-teal-600 text-white py-3 rounded-2xl font-black text-xs uppercase shadow-lg shadow-teal-100 hover:bg-teal-700 transition">Cập nhật cơ sở</button>
                </div>
            </div>
        </div>
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white p-8 rounded-[2.5rem] border shadow-sm">
                <div class="flex justify-between items-center mb-8">
                    <h3 class="font-black text-xl text-slate-800">Danh sách Không gian</h3>
                    <button type="button" class="px-4 py-2 bg-teal-50 text-teal-600 font-black text-[10px] uppercase rounded-xl hover:bg-teal-100 transition" onclick="openModal('modal-add-space')">+ Thêm mới</button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-slate-50 text-[10px] uppercase text-slate-400 font-black">
                            <tr><th class="p-4">Tên / Mã</th><th class="p-4">Loại</th><th class="p-4">Trạng thái</th><th class="p-4">Hành động</th></tr>
                        </thead>
                        <tbody class="text-xs font-bold" id="spaces-list-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="space-mgr-layer-3" class="hidden">
    <button type="button" onclick="backToLayer2()" class="text-slate-400 hover:text-teal-600 mb-6 flex items-center gap-2 font-bold text-sm">← Quay lại danh sách không gian</button>
    <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-1 space-y-6">
            <div class="bg-white p-8 rounded-[2.5rem] border shadow-sm">
                <h3 class="font-black text-xl mb-6 text-slate-800" id="detail-space-title">Chi tiết: 101</h3>
                <div class="space-y-6">
                    <div class="space-y-3">
                        <p class="text-[10px] font-black text-slate-400 uppercase mb-2 pl-1">Hình ảnh mô tả</p>
                        <div class="grid grid-cols-2 gap-2">
                            <div class="h-24 bg-slate-100 rounded-xl overflow-hidden shadow-inner">
                                <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=300" class="w-full h-full object-cover" alt="">
                            </div>
                            <div class="h-24 border-2 border-dashed border-slate-200 rounded-xl flex items-center justify-center text-slate-400 font-bold text-[10px] uppercase">+ ẢNH</div>
                        </div>
                    </div>
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Giá niêm yết (/giờ)</label>
                        <input type="text" value="250.000đ" class="w-full bg-transparent border-none p-0 text-lg font-black text-teal-600 focus:ring-0">
                    </div>
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Trạng thái</label>
                        <select class="w-full bg-transparent border-none p-0 text-sm font-black text-slate-700 outline-none">
                            <option>Sẵn sàng</option>
                            <option>Đang chuẩn bị</option>
                            <option>Có khách</option>
                            <option>Tạm ngừng hoạt động</option>
                        </select>
                    </div>
                    <button type="button" class="w-full bg-teal-600 text-white py-4 rounded-2xl font-black text-xs uppercase shadow-lg hover:bg-teal-700 transition">Lưu chi tiết</button>
                </div>
            </div>
        </div>
        <div class="lg:col-span-2">
            <div class="bg-white p-8 rounded-[2.5rem] border shadow-sm min-h-full">
                <h3 class="font-black text-xl mb-6 text-slate-800 uppercase tracking-tighter">📅 Lịch đã được đặt</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-slate-50 text-[10px] uppercase text-slate-400 font-black">
                            <tr><th class="p-4">Khách hàng</th><th class="p-4">Bắt đầu</th><th class="p-4">Kết thúc</th><th class="p-4">Thanh toán</th></tr>
                        </thead>
                        <tbody class="text-[11px]" id="space-schedule-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
